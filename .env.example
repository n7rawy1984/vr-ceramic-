# Copy to .env.local (ignored). Server-only; NEVER prefix these with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
# Legacy fallback only; prefer SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=
ADMIN_ACCESS_CODE=
ADMIN_SESSION_SECRET=

# Optional public development flag. Leave unset for normal desktop work.
# npm run dev:xr enables this for that process; production always disables it.
# VITE_XR_EMULATOR=true

# Optional temporary public presentation mode. Server-only; exact true enables it.
# PUBLIC_DEMO_MODE=true

# Browser-only presentation library; requires a new frontend build when changed.
# VITE_PUBLIC_DEMO_MODE=true

# Optional AI Designer. Boolean is safely exposed at BUILD time; server checks it too.
# Keep false until deployment protection and provider budget are configured.
AI_DESIGN_ENABLED=false
# Server-only. NEVER use VITE_ for either credential/model configuration.
OPENAI_API_KEY=
# Select an account-available model supporting Responses, images and Structured Outputs.
OPENAI_MODEL=
