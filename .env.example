# Copy to .env.local (ignored). Server-only; NEVER prefix these with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
# Legacy fallback only; prefer SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=
ADMIN_ACCESS_CODE=
ADMIN_SESSION_SECRET=

# Optional public development flag. Leave unset for normal desktop work.
# npm run dev:xr enables this for that process; production always disables it.
# VITE_XR_EMULATOR=true

# Optional temporary public presentation mode. Server-only; exact true enables it.
# PUBLIC_DEMO_MODE=true
